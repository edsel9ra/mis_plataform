APP_NAME=MIS
APP_ENV=local
APP_KEY=__GENERATE_LOCAL_SECRET__
APP_DEBUG=true
APP_URL=http://api.mis-project.local
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://app.mis-project.local

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mis_project
DB_USERNAME=mis_user
DB_PASSWORD=__GENERATE_LOCAL_SECRET__

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=localhost:3000,app.mis-project.local
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_COOKIE=mis_auth_token
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://app.mis-project.local
# Leave empty for the localhost development flow. The Next proxy makes the
# backend response same-origin to the browser, so a host-only cookie works for
# both localhost and app.mis-project.local.
# NOTE: leave SESSION_DOMAIN unset (not empty) so Laravel's env() returns null
# and the cookie stays host-only; an empty value becomes '' and breaks that.
SESSION_SAME_SITE=lax

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=__GENERATE_LOCAL_SECRET__

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=__GENERATE_LOCAL_SECRET__
REVERB_APP_KEY=__GENERATE_LOCAL_SECRET__
REVERB_APP_SECRET=__GENERATE_LOCAL_SECRET__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

MATCHING_SERVICE_URL=http://matching:8000
MATCHING_SERVICE_API_KEY=__GENERATE_LOCAL_SECRET__

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@mis.local
MAIL_FROM_NAME=MIS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_IMPERSONATE=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

PINATA_API_KEY=
PINATA_SECRET_API_KEY=
IPFS_API_KEY=
IPFS_SECRET_API_KEY=
IPFS_API_URL=https://api.pinata.cloud

POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
POLYGON_CONTRACT_ADDRESS=
POLYGON_CERTIFICATES_ENABLED=false

STRIPE_KEY=
STRIPE_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
