APP_NAME=MIS
APP_ENV=local
APP_KEY=generate-a-long-random-value
APP_DEBUG=true
APP_URL=http://api.mis-project.local
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://app.mis-project.local

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
