# Development-only Compose settings. setup.sh replaces generated placeholders
# without overwriting values that already exist in local environment files.
COMPOSE_PROJECT_NAME=mis-project

POSTGRES_DB=mis_project
POSTGRES_USER=mis_user
POSTGRES_PASSWORD=__GENERATE_LOCAL_SECRET__
POSTGRES_TEST_DB=mis_project_testing

MEILI_MASTER_KEY=__GENERATE_LOCAL_SECRET__

# The in-memory limiter is intentionally paired with one worker.
MATCHING_WORKERS=1
