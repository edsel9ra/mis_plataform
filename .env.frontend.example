NEXT_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://nginx
AUTH_COOKIE_NAME=mis_auth_token
NEXT_PUBLIC_API_TIMEOUT_MS=5000

# Reverb realtime (public connection details only — never put REVERB_APP_SECRET here).
# setup.sh writes the same REVERB_APP_KEY generated in .env.backend.
REVERB_APP_KEY=
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
