# Production template. Keep this file as documentation and inject the real
# values through a secret manager or an untracked env file.
COMPOSE_PROJECT_NAME=mis-project

# Every application image must be a release artifact referenced by digest.
NGINX_IMAGE=ghcr.io/your-org/mis-nginx@sha256:REPLACE_WITH_RELEASE_DIGEST
BACKEND_IMAGE=ghcr.io/your-org/mis-backend@sha256:REPLACE_WITH_RELEASE_DIGEST
FRONTEND_IMAGE=ghcr.io/your-org/mis-frontend@sha256:REPLACE_WITH_RELEASE_DIGEST
MATCHING_IMAGE=ghcr.io/your-org/mis-matching@sha256:REPLACE_WITH_RELEASE_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_DIGEST
REDIS_IMAGE=redis@sha256:REPLACE_WITH_APPROVED_DIGEST
MEILI_IMAGE=getmeili/meilisearch@sha256:REPLACE_WITH_APPROVED_DIGEST

# These files are not versioned. They must contain production values.
BACKEND_ENV_FILE=.env.backend.production
FRONTEND_ENV_FILE=.env.frontend.production
MATCHING_ENV_FILE=.env.matching.production

POSTGRES_DB=mis_project
POSTGRES_USER=mis_user
POSTGRES_PASSWORD=__SET_IN_SECRET_MANAGER__
REDIS_PASSWORD=__SET_IN_SECRET_MANAGER__
MEILI_MASTER_KEY=__SET_IN_SECRET_MANAGER__
